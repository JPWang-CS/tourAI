{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tourAI/schemas/itinerary.schema.json",
  "title": "Itinerary",
  "description": "单日行程安排",
  "type": "object",
  "required": ["day_number", "theme", "spots", "meals"],
  "properties": {
    "day_number": {
      "type": "integer",
      "minimum": 1,
      "description": "第几天"
    },
    "theme": {
      "type": "string",
      "description": "当日主题，如 '浪漫启程'"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "具体日期"
    },
    "route_summary": {
      "type": "string",
      "description": "路线概览，如 '威海公园 → 火炬八街 → 国际海水浴场'"
    },
    "spots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "spot.schema.json" },
      "description": "当日景点列表"
    },
    "hotel": {
      "oneOf": [
        { "$ref": "hotel.schema.json" },
        { "type": "null" }
      ],
      "description": "当晚住宿酒店（最后一天可为 null）"
    },
    "hotel_to_first_route": {
      "oneOf": [
        { "$ref": "route.schema.json" },
        { "type": "null" }
      ],
      "description": "酒店到当日首个景点的路线（Day1为null）"
    },
    "spot_routes": {
      "type": "array",
      "items": { "$ref": "route.schema.json" },
      "description": "景点之间的路线列表"
    },
    "last_to_hotel_route": {
      "oneOf": [
        { "$ref": "route.schema.json" },
        { "type": "null" }
      ],
      "description": "末景点到当晚酒店的路线"
    },
    "meals": {
      "type": "object",
      "properties": {
        "breakfast": { "$ref": "meal.schema.json" },
        "lunch": { "$ref": "meal.schema.json" },
        "dinner": { "$ref": "meal.schema.json" }
      },
      "description": "三餐安排"
    },
    "notes": {
      "type": "string",
      "description": "当日备注"
    },
    "requires_accommodation": {
      "type": "boolean",
      "description": "当日是否需要住宿",
      "default": true
    }
  }
}
