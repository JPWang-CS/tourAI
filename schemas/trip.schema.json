{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tourAI/schemas/trip.schema.json",
  "title": "Trip",
  "description": "完整旅行规划 —— tourAI 的核心数据结构。所有 Agent 通过此结构交换数据。",
  "type": "object",
  "required": ["trip_id", "title", "destination", "duration_days", "itinerary", "metadata"],
  "properties": {
    "trip_id": {
      "type": "string",
      "format": "uuid",
      "description": "行程唯一标识"
    },
    "title": {
      "type": "string",
      "description": "行程标题，如 '威海4天3晚浪漫之旅'"
    },
    "subtitle": {
      "type": "string",
      "description": "副标题"
    },
    "destination": {
      "type": "object",
      "required": ["city"],
      "properties": {
        "city": { "type": "string", "description": "目的地城市" },
        "province": { "type": "string", "description": "省份" },
        "region": { "type": "string", "description": "区域：华北/华东/华南/西南/西北/东北/华中" }
      }
    },
    "departure_city": {
      "type": "string",
      "description": "出发城市"
    },
    "dates": {
      "type": "object",
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      },
      "description": "旅行日期范围（可选）"
    },
    "duration_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "description": "旅行天数"
    },
    "style": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["romantic", "family", "adventure", "foodie", "budget", "luxury", "photography", "cultural", "relaxing"]
      },
      "description": "旅行风格标签"
    },
    "pace": {
      "type": "string",
      "enum": ["relaxed", "moderate", "intensive"],
      "description": "旅行节奏",
      "default": "moderate"
    },
    "persons": {
      "type": "integer",
      "minimum": 1,
      "description": "出行人数",
      "default": 2
    },
    "transport_to_dest": {
      "type": "array",
      "items": { "$ref": "transport.schema.json" },
      "description": "从出发地到目的地的城际交通选项"
    },
    "transport_return": {
      "type": "array",
      "items": { "$ref": "transport.schema.json" },
      "description": "返程交通选项"
    },
    "itinerary": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "itinerary.schema.json" },
      "description": "每日行程"
    },
    "hotels_summary": {
      "type": "array",
      "items": { "$ref": "hotel.schema.json" },
      "description": "全程酒店汇总"
    },
    "food_summary": {
      "type": "array",
      "items": { "$ref": "meal.schema.json" },
      "description": "全程美食汇总"
    },
    "avoid_list": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["wrong", "right"],
        "properties": {
          "wrong": { "type": "string", "description": "错误做法" },
          "right": { "type": "string", "description": "正确做法" },
          "category": {
            "type": "string",
            "enum": ["transport", "food", "shopping", "safety", "photo", "ticket", "general"]
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "warning", "tip"],
            "default": "warning"
          }
        }
      },
      "description": "避坑清单"
    },
    "budget": {
      "$ref": "budget.schema.json",
      "description": "预算估算"
    },
    "tips": {
      "type": "array",
      "items": { "type": "string" },
      "description": "出行提示"
    },
    "weather": {
      "type": "object",
      "properties": {
        "season": { "type": "string", "description": "季节" },
        "temp_range": { "type": "string", "description": "温度范围" },
        "clothing": { "type": "string", "description": "穿衣建议" },
        "precautions": { "type": "string", "description": "天气注意事项" }
      },
      "description": "天气/季节信息（可选）"
    },
    "metadata": {
      "type": "object",
      "required": ["generated_at"],
      "properties": {
        "amap_used": {
          "type": "boolean",
          "description": "是否使用高德 API 计算真实路线",
          "default": false
        },
        "sources": {
          "type": "array",
          "items": { "type": "string" },
          "description": "数据来源列表：amap/xhs/mafengwo/ctrip/websearch/llm"
        },
        "cache_hits": {
          "type": "array",
          "items": { "type": "string" },
          "description": "命中的缓存城市"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "生成时间"
        },
        "version": {
          "type": "string",
          "description": "tourAI 版本号"
        },
        "editable": {
          "type": "boolean",
          "default": true,
          "description": "是否可增量编辑"
        }
      }
    }
  }
}
