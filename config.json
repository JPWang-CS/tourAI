{
  "name": "tourAI",
  "version": "2.0.0",
  "description": "智能旅行规划助手 —— 多源数据驱动（小红书/马蜂窝/高德），结构化行程规划，Agent 流水线自动生成精美旅游攻略HTML。",
  "author": "JPWang-CS",
  "repository": "https://github.com/JPWang-CS/tourAI.git",
  "tags": [
    "travel", "旅游", "攻略", "行程规划", "tour", "guide",
    "html", "vacation", "romantic", "情侣", "周末", "自驾",
    "multi-source", "agent-pipeline", "structured-data",
    "xiaohongshu", "mafengwo", "amap"
  ],
  "dependencies": {
    "python": ">=3.8",
    "packages": ["requests"]
  },
  "env": {
    "AMAP_KEY": {
      "description": "高德Web服务API Key（用于POI搜索和路线计算）",
      "required": false
    },
    "AMAP_MCP_KEY": {
      "description": "高德MCP Server API Key（可选，优先于AMAP_KEY）",
      "required": false
    },
    "XHS_COOKIE": {
      "description": "小红书Cookie（用于XHS MCP，可选）",
      "required": false
    }
  },
  "mcp": {
    "recommended": [
      "sugarforever/amap-mcp-server",
      "@anthropic-fans/xhs-mcp"
    ]
  },
  "defaults": {
    "departure_city": "深圳",
    "persons": 2,
    "pace": "moderate",
    "style": ["romantic"]
  }
}
