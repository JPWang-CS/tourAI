{
  "name": "tourAI",
  "version": "2.0.0",
  "description": "智能旅行规划助手 —— 多源数据驱动（小红书/马蜂窝/高德），结构化行程规划，Agent 流水线自动生成精美旅游攻略HTML。支持国内外城市、情侣浪漫游、周末短途游、自驾游、多城市联游。",
  "author": "JPWang-CS",
  "tags": ["travel", "旅游", "攻略", "行程规划", "tour", "guide", "html", "romantic", "情侣", "multi-source"],
  "dependencies": {
    "python": ">=3.8",
    "pip": ["requests"]
  },
  "env": {
    "AMAP_KEY": "高德Web服务API Key（可选）",
    "XHS_COOKIE": "小红书Cookie（可选）"
  },
  "minVersion": "2.0.0"
}
